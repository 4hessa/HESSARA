---
interface Props { variant?: 'advisory' | 'consult' | 'models'; }
const { variant = 'advisory' } = Astro.props;
const side = { advisory: ['Overview', 'Advisors', 'Sessions', 'Workstreams', 'Reports', 'Settings'], consult: ['Overview', 'Session', 'Specialists', 'Simulations', 'Decisions', 'Exports'], models: ['Registry', 'Playground', 'Routing', 'Benchmarks', 'Usage', 'Keys'] }[variant];
const titles = { advisory: 'Dashboard', consult: 'Multi-agent consultation', models: 'Prompt comparison playground' };
---
<div class="mock" role="img" aria-label={`HESSARA workspace preview: ${titles[variant]}`}>
  <div class="mock__rail"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="mock__side"><b>HESSARA</b>{side.map((s, i) => <span class={i === 1 ? 'on' : ''}>{s}</span>)}</div>
  <div class="mock__main">
    <div class="mock__bar"><span>{titles[variant]}</span><em><i></i><i></i><i></i></em></div>
    {variant === 'advisory' && (
      <Fragment>
        <div class="pane"><b>Signal strength by workstream</b>
          <svg viewBox="0 0 120 52" preserveAspectRatio="none"><path d="M0 51.500h120" stroke="#bbb" stroke-width=".5"/>{[14, 22, 18, 30, 26, 38, 34, 46].map((h, i) => <rect x={6 + i * 14} y={51 - h} width="7" height={h} fill={i % 2 ? '#111' : '#b9b9b5'} />)}</svg>
        </div>
        <div class="pane pane--tall"><b>Advisor</b>
          <span class="bubble">Which markets should we prioritise next year?</span>
          <span class="bubble bubble--in">Three scenarios are ready. The second carries the least execution risk.</span>
          <span class="bubble">Show the assumptions behind it.</span>
          <span class="field">Type a message…</span>
        </div>
        <div class="pane"><b>Coverage</b>
          <svg viewBox="0 0 120 44"><circle cx="24" cy="22" r="14" fill="none" stroke="#dcdcd8" stroke-width="5"/><circle cx="24" cy="22" r="14" fill="none" stroke="#111" stroke-width="5" stroke-dasharray="62 88" transform="rotate(-90 24 22)"/><g fill="#111"><rect x="52" y="10" width="4" height="4"/><rect x="60" y="11" width="44" height="2" fill="#cfcfcb"/><rect x="52" y="20" width="4" height="4" fill="#8d8d89"/><rect x="60" y="21" width="34" height="2" fill="#cfcfcb"/><rect x="52" y="30" width="4" height="4" fill="#dcdcd8"/><rect x="60" y="31" width="40" height="2" fill="#cfcfcb"/></g></svg>
        </div>
      </Fragment>
    )}
    {variant === 'consult' && (
      <Fragment>
        <div class="pane"><b>Council thread</b>
          <span class="bubble">Stress-test the expansion plan against a supply shock.</span>
          <span class="bubble bubble--in">Strategist and Oracle disagree on timing. Opening a simulation.</span>
          <span class="field">Type a message…</span>
        </div>
        <div class="pane pane--tall"><b>Decision tree</b>
          <svg viewBox="0 0 110 120"><g fill="none" stroke="#888" stroke-width=".7"><path d="M30 60h10M40 22v76M40 22h12M40 60h12M40 98h12M84 22h8M92 12v20M92 12h8M92 32h8M84 60h8M92 50v20M92 50h8M92 70h8"/></g><g font-size="5" font-family="inherit" text-anchor="middle"><rect x="2" y="54" width="28" height="12" rx="2" fill="#ededea"/><text x="16" y="62" fill="#222">Baseline</text><rect x="52" y="16" width="32" height="12" rx="2" fill="#111"/><text x="68" y="24" fill="#fff">Scenario A</text><rect x="52" y="54" width="32" height="12" rx="2" fill="#111"/><text x="68" y="62" fill="#fff">Scenario B</text><rect x="52" y="92" width="32" height="12" rx="2" fill="#ededea"/><text x="68" y="100" fill="#222">Hold</text></g><g fill="#ededea"><rect x="100" y="8" width="10" height="8" rx="1.500"/><rect x="100" y="28" width="10" height="8" rx="1.500"/><rect x="100" y="46" width="10" height="8" rx="1.500"/><rect x="100" y="66" width="10" height="8" rx="1.500"/></g></svg>
        </div>
        <div class="pane"><b>Scenario probability</b>
          <div class="slider"><div><span>Scenario A</span><span>73%</span></div><u style="--v:73%"></u></div>
          <div class="slider"><div><span>Scenario B</span><span>48%</span></div><u style="--v:48%"></u></div>
          <span class="pill">Run simulation</span>
        </div>
      </Fragment>
    )}
    {variant === 'models' && (
      <Fragment>
        <div class="pane pane--tall"><b>Prompt comparison</b>
          <span class="field" style="margin:0">Select model…</span>
          <div class="slider"><div><span>Temperature</span><span>0.40</span></div><u style="--v:40%"></u></div>
          <div class="slider"><div><span>Reasoning depth</span><span>0.75</span></div><u style="--v:75%"></u></div>
          <div class="slider"><div><span>Context budget</span><span>0.60</span></div><u style="--v:60%"></u></div>
          <span class="pill">Run comparison</span>
        </div>
        <div class="pane"><b>Token speed</b>
          <svg viewBox="0 0 120 46" preserveAspectRatio="none"><path d="M0 40C14 38 20 26 34 28s16-10 30-8 18-14 30-10 16-8 26-8V46H0z" fill="#e4e4e0"/><path d="M0 40C14 38 20 26 34 28s16-10 30-8 18-14 30-10 16-8 26-8" fill="none" stroke="#111" stroke-width="1"/></svg>
        </div>
        <div class="pane"><b>Latency by route</b>
          <svg viewBox="0 0 120 46" preserveAspectRatio="none"><path d="M0 45.500h120" stroke="#bbb" stroke-width=".5"/>{[30, 18, 24, 14, 36, 20, 28, 16].map((h, i) => <rect x={6 + i * 14} y={45 - h} width="7" height={h} fill={i % 2 ? '#b9b9b5' : '#111'} />)}</svg>
        </div>
      </Fragment>
    )}
  </div>
</div>
