---
import Icon from './Icon.astro';
interface Item { icon: string; title: string; text: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<ol class="cards">
  {items.map((it, i) => {
    const Tag = it.href ? 'a' : 'div';
    return (
      <li>
        <Tag class="card frame" href={it.href}>
          <Icon name={it.icon} />
          <span class="card__n">{String(i + 1).padStart(2, '0')} /</span>
          <h3 class="card__t">{it.title}</h3>
          <p class="card__d">{it.text}</p>
        </Tag>
      </li>
    );
  })}
</ol>
