---
interface Props { title: string; actions: { label: string; href: string; ghost?: boolean }[]; }
const { title, actions } = Astro.props;
---
<section class="section" id="cta">
  <div class="cta frame">
    <h2>{title}</h2>
    <div class="btn-row">
      {actions.map((a) => <a class:list={['btn', { 'btn--ghost': a.ghost }]} href={a.href}>{a.label}</a>)}
    </div>
  </div>
</section>
