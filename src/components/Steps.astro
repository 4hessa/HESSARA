---
interface Props { items: { title: string; text: string }[]; }
const { items } = Astro.props;
---
<ol class="steps">
  {items.map((it, i) => (
    <li class="step">
      <div class="step__n">{String(i + 1).padStart(2, '0')}</div>
      <h3 class="step__t">{it.title}</h3>
      <p class="step__d">{it.text}</p>
    </li>
  ))}
</ol>
