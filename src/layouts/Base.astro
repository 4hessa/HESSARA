---
import '../styles/global.css';
import Art from '../components/Art.astro';
import { nav, footer } from '../data/site';
interface Props {
  title: string; description: string; current?: string;
  cta: { label: string; href: string };
  art: { name: any; kind?: 'frame' | 'fade'; x?: string; y?: string; s?: number; fade?: string };
  heroTop?: string; glow?: boolean;
}
const { title, description, current, cta, art, heroTop = '25.2rem', glow = true } = Astro.props;
const is = (href: string) => (current === href ? 'page' : undefined);
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og.jpg', site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:site_name" content="HESSARA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="HESSARA: a lone figure on a pale path between dark forest and gothic pillars" />}
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page" style={`--hero-top:${heroTop}`}>
      <Art {...art} />
      <header class="nav">
        <a class="brand" href="/" aria-label="HESSARA home">HESSARA</a>
        <nav class="nav__links" aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={is(n.href)}>{n.label}</a>)}
        </nav>
        <a class="btn" href={cta.href}>{cta.label}</a>
        <details class="menu">
          <summary aria-label="Open menu">Menu</summary>
          <ul>{nav.map((n) => <li><a href={n.href} aria-current={is(n.href)}>{n.label}</a></li>)}</ul>
        </details>
      </header>
      <main id="main">
        <section class:list={['hero', { 'hero--glow': glow }]}>
          <div class="hero__inner"><slot name="hero" /></div>
        </section>
        <div class="sheet">
          <slot />
          <footer class="footer">
            <div class="footer__cols">
              {footer.map((c) => (
                <div>
                  <h2 class="footer__title">{c.title}</h2>
                  <ul>{c.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
                </div>
              ))}
            </div>
            <div class="footer__base">
              <span>© HESSARA</span>
              <div aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M3 2h10v3H6v3h6v3H6v3H3z"/></svg>
                <svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/><path d="M8.800 13V8.600h1.500l.2-1.700H8.800V5.800c0-.5.200-.8.900-.8h.9V3.500C10.300 3.400 9.800 3.400 9.300 3.400c-1.300 0-2.200.8-2.200 2.200v1.300H5.600v1.700h1.500V13z" fill="#fafaf9"/></svg>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.400"><rect x="1.700" y="1.700" width="12.600" height="12.600" rx="3.500"/><circle cx="8" cy="8" r="3"/><circle cx="11.700" cy="4.300" r=".5" fill="currentColor"/></svg>
              </div>
            </div>
          </footer>
        </div>
      </main>
    </div>
  </body>
</html>
