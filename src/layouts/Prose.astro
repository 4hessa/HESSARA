---
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
const { frontmatter: f } = Astro.props;
const arts: Record<string, { art: any; heroTop?: string }> = {
  insights: { art: { name: 'insights', kind: 'fade', fade: '--art-h:26rem;--f1:40%;--f2:66%;--f3:94%' }, heroTop: '29rem' },
  resources: { art: { name: 'resources', kind: 'fade' } },
  platform: { art: { name: 'platform', kind: 'fade' } },
  home: { art: { name: 'home', kind: 'fade', fade: '--f1:38%;--f2:60%;--f3:86%' } },
};
const picked = arts[f.art ?? f.section ?? 'home'];
const back = f.section === 'insights' ? ['/insights/', 'All insights'] : f.section === 'resources' ? ['/resources/', 'All resources'] : null;
---
<Base
  title={`${f.title} — HESSARA`}
  description={f.description}
  current={f.section ? `/${f.section}/` : undefined}
  cta={{ label: 'Talk to an Advisor', href: '/consulting/' }}
  art={picked.art}
  heroTop={picked.heroTop}
>
  <Fragment slot="hero">
    <h1>{f.title}</h1>
    {f.sub && <p class="hero__sub">{f.sub}</p>}
    {f.kicker && <p class="hero__kicker">{f.kicker}</p>}
  </Fragment>
  <article class="section prose">
    {f.draft && <p class="note"><b>Draft.</b> {f.draft}</p>}
    <slot />
    {back && <p class="prose__back"><a href={back[0]}>← {back[1]}</a></p>}
  </article>
  <Cta title={f.cta ?? 'Ready to navigate the complex?'} actions={[
    { label: 'Start a Consultation', href: '/consulting/' },
    { label: 'Explore the Platform', href: '/platform/', ghost: true },
  ]} />
</Base>
