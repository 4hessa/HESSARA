---
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import Cta from '../components/Cta.astro';
import { contactEmail, consult } from '../data/site';
---
<Base
  title="Contact — HESSARA"
  description="Get in touch with HESSARA about advisory sessions, language models, programs, or careers."
  cta={{ label: 'Talk to an Advisor', href: consult() }}
  art={{ name: 'home', kind: 'fade', fade: '--f1:38%;--f2:60%;--f3:86%' }}
>
  <Fragment slot="hero">
    <h1>Start the Conversation</h1>
    <p class="hero__sub">Tell us what you are trying to decide</p>
    <div class="hero__copy">
      <p>Whether you want to run an advisory session, evaluate our language models, or ask about programs and careers, we would like to hear from you.</p>
    </div>
    {contactEmail && (
      <div class="btn-row"><a class="btn" href={`mailto:${contactEmail}`}>Email {contactEmail}</a></div>
    )}
  </Fragment>

  <section class="section">
    <p class="eyebrow">How we can help</p>
    <h2 class="title">Choose Your Path</h2>
    <Cards items={[
      { icon: 'knight', title: 'Advisory Sessions', text: 'Bring a decision to a council of specialists.', href: '/consulting/' },
      { icon: 'gem', title: 'Language Models', text: 'Evaluate models for your own domain.', href: '/models/' },
      { icon: 'map', title: 'Programs & Careers', text: 'Partner, research, or work with us.', href: '/programs/' },
    ]} />
  </section>

  <section class="section prose" style="padding-top:0">
    <h2 style="margin-top:0">Before you write</h2>
    <p style="font-family:var(--sans);font-size:1rem;line-height:1.5">A short note is enough. It helps if you include:</p>
    <ul>
      <li>the decision or question you are working on</li>
      <li>your organisation and role</li>
      <li>any timing that matters</li>
    </ul>
    <p>Please do not send confidential documents in a first message.</p>
    {!contactEmail && <p class="note">Our contact address will be published on this page shortly.</p>}
  </section>

  <Cta title="Prefer to explore first?" actions={[
    { label: 'Browse Resources', href: '/resources/' },
    { label: 'Read Insights', href: '/insights/', ghost: true },
  ]} />
</Base>
