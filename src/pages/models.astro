---
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import Mock from '../components/Mock.astro';
import Cta from '../components/Cta.astro';
---
<Base
  title="Specialized Language Models — HESSARA"
  description="Domain-tuned foundation models and neural reasoning engines, engineered for deep analytical synthesis, multi-lingual precision, and verifiable strategic reasoning."
  current="/models/"
  cta={{ label: 'Deploy Model', href: '#cta' }}
  art={{ name: 'models', kind: 'fade', s: 1.14, x: '5.5rem', y: '-7.5rem' }}
>
  <Fragment slot="hero">
    <h1>Specialized Language Models</h1>
    <p class="hero__sub">Domain-Tuned Foundation Models &amp; Neural Reasoning Engines</p>
    <div class="hero__copy">
      <p>Access HESSARA’s proprietary suite of specialized LLMs engineered for deep analytical synthesis, multi-lingual precision, and verifiable strategic reasoning.</p>
    </div>
    <div class="btn-row">
      <a class="btn" href="#ecosystem">Explore Model Registry</a>
      <a class="btn btn--ghost" href="#playground">Benchmark Performance</a>
    </div>
  </Fragment>

  <section class="section" id="ecosystem">
    <p class="eyebrow">Architecture &amp; Capabilities</p>
    <h2 class="title">The HESSARA Model Ecosystem</h2>
    <Cards items={[
      { icon: 'gem', title: 'Cognitive Reasoning LLM', text: 'Specialized AI models and multi-lateral reasoning.' },
      { icon: 'astrolabe', title: 'Quantitative & Market LLM', text: 'Measures at ultimate scale with predictive analysis.' },
      { icon: 'key', title: 'Sovereign Enterprise LLM', text: 'Decision-smart development and authoritative insights.' },
    ]} />
  </section>

  <section class="section" id="playground" style="padding-bottom:1.6rem">
    <p class="eyebrow">Model Playground</p>
    <h2 class="title">Neural Routing &amp; Context Synthesis</h2>
  </section>

  <section class="section feature feature--bleed">
    <div>
      <h3>Dynamic Model Orchestration</h3>
      <p>HESSARA connects you with our specialized AI and domain-specific research to dissect the problem, simulate outcomes, and architect actionable roadmaps.</p>
      <ul>
        <li>Token context windows (up to 128k)</li>
        <li>Zero-hallucination citation grounding</li>
        <li>Latency optimization &amp; routing</li>
      </ul>
    </div>
    <Mock variant="models" />
  </section>

  <Cta title="Ready to integrate HESSARA language models?" actions={[{ label: 'Request API & Sandbox', href: '/resources/' }]} />
</Base>
