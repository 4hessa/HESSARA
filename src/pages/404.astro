---
import { consult } from '../data/site';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
---
<Base
  title="Page not found — HESSARA"
  description="The page you were looking for could not be found."
  cta={{ label: 'Talk to an Advisor', href: consult() }}
  art={{ name: 'home' }}
  glow={false}
>
  <Fragment slot="hero">
    <h1>This path leads nowhere</h1>
    <p class="hero__sub">Error 404 — Page Not Found</p>
    <div class="hero__copy">
      <p>The page you were looking for has moved or never existed. The way back is below.</p>
    </div>
    <div class="btn-row">
      <a class="btn" href="/">Return Home</a>
      <a class="btn btn--ghost" href="/resources/">Browse Resources</a>
    </div>
  </Fragment>
  <Cta title="Looking for guidance instead?" actions={[{ label: 'Start a Consultation', href: consult() }]} />
</Base>
