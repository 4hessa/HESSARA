---
import { consult } from '../data/site';
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import Steps from '../components/Steps.astro';
import Mock from '../components/Mock.astro';
import Cta from '../components/Cta.astro';
---
<Base
  title="HESSARA — Intelligence That Guides. Insight That Matters"
  description="HESSARA is an AI-powered advisory platform connecting you with specialized AI models and intelligent agents to navigate complex decisions."
  cta={{ label: 'Talk to an Advisor', href: consult() }}
  art={{ name: 'home' }}
  glow={false}
>
  <Fragment slot="hero">
    <h1 class="h1-split">Intelligence That Guides. <br />Insight That Matters</h1>
    <p class="hero__sub">Your AI-Powered Advisory Platform</p>
    <div class="hero__copy">
      <p>HESSARA connects you with specialized AI models and intelligent agents to navigate complex challenges, explore solutions, and make informed decisions.</p>
      <p>Experience personalized, research-driven guidance designed to turn complex questions into actionable insights.</p>
    </div>
    <div class="btn-row">
      <a class="btn" href="#suite">Explore the Suite</a>
      <a class="btn btn--ghost" href={consult()}>Talk to an Advisor</a>
    </div>
  </Fragment>

  <section class="section" id="suite">
    <p class="eyebrow">Applications</p>
    <h2 class="title">Our Specialized Intelligence Suite</h2>
    <Cards items={[
      { icon: 'compass', title: 'Strategic Navigation', text: 'Specialized AI models and intelligent navigation.', href: '/consulting/' },
      { icon: 'chart', title: 'Predictive Analysis', text: 'Measure likely outcomes with predictive analysis.', href: '/models/' },
      { icon: 'scales', title: 'Decision Framing', text: 'Decision support built on defensible insights.', href: '/platform/' },
    ]} />
  </section>

  <section class="section" id="process">
    <p class="eyebrow">Process</p>
    <h2 class="title">Your Path to Action</h2>
    <Steps items={[
      { title: 'Define', text: 'Define the question, its constraints, and the context for analysis.' },
      { title: 'Align', text: 'Align models and agents with your evidence and objectives.' },
      { title: 'Insights', text: 'Turn findings into recommendations and actionable insights.' },
    ]} />
  </section>

  <section class="section feature">
    <div>
      <h3>Seamless, intuitive advisory at your command</h3>
      <p>HESSARA connects you with specialized AI models and intelligent agents to turn complex questions into actionable insights.</p>
    </div>
    <Mock variant="advisory" />
  </section>

  <Cta title="Ready to navigate the complex?" actions={[
    { label: 'Deploy HESSARA', href: '/platform/' },
    { label: 'Explore Documentation', href: '/resources/', ghost: true },
  ]} />
</Base>
