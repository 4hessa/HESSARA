---
import Base from '../../layouts/Base.astro';
import Cards from '../../components/Cards.astro';
import Cta from '../../components/Cta.astro';
const rows = [
  ['Research Note', 'How multi-agent deliberation changes the shape of a strategy review', 'Where a council of specialist models helps, and where a single careful analyst is still the better tool.', '/insights/multi-agent-deliberation/'],
  ['Field Report', 'Grounding answers in evidence: what citation-first reasoning looks like', 'A practical look at tracing each claim in a recommendation back to the document it came from.', '/insights/citation-first-reasoning/'],
  ['Briefing', 'Scenario simulation for leadership teams: a working method', 'Framing assumptions, ranges, and decision points before any model is asked to forecast.', '/insights/scenario-simulation/'],
  ['Research Note', 'Choosing between a general model and a domain-tuned one', 'A short framework for matching the model to the question, the stakes, and the data at hand.', '/insights/general-vs-domain-models/'],
];
---
<Base
  title="Insights — HESSARA"
  description="Research notes, field reports, and briefings from HESSARA on AI-assisted advisory, reasoning, and decision-making."
  current="/insights/"
  cta={{ label: 'Talk to an Advisor', href: '/consulting/' }}
  art={{ name: 'insights', y: '-2.5rem' }}
  heroTop="42.5rem"
>
  <Fragment slot="hero">
    <h1>Insights That Light the Way</h1>
    <p class="hero__sub">Research Notes, Field Reports &amp; Briefings</p>
    <div class="hero__copy">
      <p>Considered writing on AI-assisted advisory: how specialized models reason, where they fall short, and how to turn their output into decisions you can defend.</p>
    </div>
    <div class="btn-row">
      <a class="btn" href="#latest">Read the Latest</a>
      <a class="btn btn--ghost" href="#formats">Browse by Format</a>
    </div>
  </Fragment>

  <section class="section" id="formats">
    <p class="eyebrow">Formats</p>
    <h2 class="title">Three Ways to Read HESSARA</h2>
    <Cards items={[
      { icon: 'quill', title: 'Research Notes', text: 'Longer studies of method, evidence, and limits.' },
      { icon: 'telescope', title: 'Field Reports', text: 'What we observe when models meet real work.' },
      { icon: 'lantern', title: 'Briefings', text: 'Short guidance for leaders who must decide.' },
    ]} />
  </section>

  <section class="section" id="latest">
    <p class="eyebrow">Latest</p>
    <h2 class="title">Recent Thinking</h2>
    <div class="rows">
      {rows.map(([k, t, d, href]) => (
        <a class="row" href={href}>
          <span class="row__k">{k}</span>
          <span><span class="row__t">{t}</span><p class="row__d">{d}</p></span>
          <span class="row__a" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <Cta title="Ready to turn insight into action?" actions={[
    { label: 'Start a Consultation', href: '/consulting/' },
    { label: 'Explore the Platform', href: '/platform/', ghost: true },
  ]} />
</Base>
