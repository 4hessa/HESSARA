# ───────── هسّارة: إعدادات الخادم (لا تُرسل أي قيمة من هنا إلى المتصفح) ─────────
# قاعدة البيانات. دون أي ضبط: ملف SQLite في ./var/hessara.db
# HESSARA_DB_PATH=./var/hessara.db
# للاستضافة عديمة الحالة (لا قرص دائم): رابط PostgreSQL. عند ضبطه يُستخدم بدل SQLite.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# مطلوب فقط إن لم يُربط المفتاح بمساحة عمل عند إنشائه (المعرّف من صفحة Workspaces في لوحة Claude):
# ANTHROPIC_WORKSPACE_ID=

# OpenAI (GPT) — اسم الإصدار يُحدَّد صراحةً ولا تفترضه المنصة
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Google (Gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=

# DeepSeek (واجهة متوافقة مع OpenAI)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen (واجهة متوافقة مع OpenAI لدى المزود الذي تختاره)
# QWEN_API_KEY=
# QWEN_MODEL=
# QWEN_BASE_URL=

# Llama (لدى مستضيف يوفّر واجهة متوافقة مع OpenAI)
# LLAMA_API_KEY=
# LLAMA_MODEL=
# LLAMA_BASE_URL=

# نموذج محلي على الخادم نفسه (مثل Ollama) — يتصل به الخادم لا المتصفح
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL=

# خلف وسيط عكسي موثوق يكتب X-Forwarded-For: فعّل لتطبيق حدود المعدل لكل عنوان عميل.
# على Vercel: فعّله. توثيق Vercel ينص على أن المنصة تكتب هذه الترويسة بنفسها ولا تمرر عناوين خارجية.
# لا تفعّله إن كان الخادم متاحًا مباشرة، فالترويسة حينها يكتبها العميل.
# HESSARA_TRUST_PROXY=1
